# Server-side only. Get a key from console.anthropic.com. Never commit the real value.
ANTHROPIC_API_KEY=

# Google sign-in (optional — anonymous flow works without it). Create an
# OAuth client at console.cloud.google.com, redirect URI:
# <your-deployed-url>/api/auth/callback/google (and http://localhost:3000/api/auth/callback/google for local dev).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Random secret NextAuth uses to sign session tokens. Generate with:
# openssl rand -base64 32
AUTH_SECRET=

# Postgres connection string for signed-in profile persistence (optional —
# anonymous flow works without it). Provision via Vercel's Neon integration
# and copy the connection string it gives you; then run db/schema.sql once.
POSTGRES_URL=
